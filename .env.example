# Server only. Never use a VITE_ prefix for this value.
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# Vite development/preview proxy target (server-side).
BACKEND_URL=http://localhost:8080
# Browser API prefix. For production use a reverse proxy at /backend or an explicit API URL with BE CORS configured.
VITE_API_BASE_URL=/backend

